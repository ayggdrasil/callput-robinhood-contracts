@@ -12,3 +12,14 @@ export function accountAccessStage(snapshot: SponsoredSetupSnapshot, consent: Tr
   if (snapshot.directDeposit?.balance === '0') return 'deposit';
   return current.localApprovalCurrent ? 'ready' : 'activating';
 }
+
+/** Whether a direct-deposit account can safely receive its first funding.
+ * A relay-accepted grant may be installed by that deposit, but only while the
+ * canonical operation is explicitly waiting for an empty account deposit. */
+export function accountAccessFundingReady(snapshot: SponsoredSetupSnapshot, consent: TradingConsentSnapshot | null): boolean {
+  const current = consent?.current, deposit = snapshot.directDeposit;
+  if (!snapshot.account || !deposit || !current) return false;
+  if (current.installed && current.localApprovalCurrent) return true;
+  return !current.installed && deposit.balance === '0' && current.approvalRecorded
+    && current.awaitingDeposit && current.operationPending;
+}
