+const DEPLOYMENT_POLICIES: Record<SupportedChainsType, TradingModePolicy> = {
   Base: 'wallet-only',
   Giwa: 'deposit-only',
   Robinhood: 'deposit-only',
 };
+
+export interface TradingModeResolverInput {
+  dev: boolean;
+  hostname: string;
+  robinhoodWalletFlag: string | undefined;
+}
+
+/**
+ * Product policy, independent of whether account infrastructure is reachable.
+ * The Robinhood wallet route is a local QA escape hatch only: it requires the
+ * Vite dev build, an explicit flag, and a loopback hostname. Production and
+ * every non-loopback host always retain the deployment policy.
+ */
+export function resolveTradingModePolicies({
+  dev,
+  hostname,
+  robinhoodWalletFlag,
+}: TradingModeResolverInput): Record<SupportedChainsType, TradingModePolicy> {
+  const policies = {...DEPLOYMENT_POLICIES};
+  const loopback = hostname === 'localhost' || hostname === '127.0.0.1';
+  if (dev && loopback && robinhoodWalletFlag === '1') {
+    policies[SupportedChains.Robinhood] = 'wallet-only';
+  }
+  return policies;
+}
+
+const browserHostname = typeof window === 'undefined' ? '' : window.location.hostname;
+export const TRADING_MODE_POLICIES = resolveTradingModePolicies({
+  dev: Boolean(import.meta.env?.DEV),
+  hostname: browserHostname,
+  robinhoodWalletFlag: import.meta.env?.VITE_DEV_ROBINHOOD_WALLET_TRADING,
+});
